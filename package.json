{
  "name": "@hao0311/dsh-sidebar-tidy",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "description": "Tidy the DeepSeek Harness Web GUI sidebar: keep only Plugins and Automation, tuck every other global panel into a More menu. Panels added later move there automatically.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "ui",
    "customization"
  ],
  "license": "MIT",
  "homepage": "https://awesome-dsh-plugin.com/p/Hao0311/dsh-sidebar-tidy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hao0311/dsh-sidebar-tidy.git"
  },
  "bugs": {
    "url": "https://github.com/Hao0311/dsh-sidebar-tidy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-0"
  }
}
